# ---------------------------------------------------------------------------
# Proyecto de PLATAFORMA (panel /admin + API /api/v1)
# ---------------------------------------------------------------------------

# Supabase local (`npm run supabase:status` muestra los valores actuales)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_local_publishable_key

# Se salta TODAS las políticas RLS. Solo servidor, nunca con prefijo
# NEXT_PUBLIC_, y nunca en el proyecto de la landing de un cliente.
SUPABASE_SECRET_KEY=

# Servicios externos opcionales para probar todas las funciones
GEMINI_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Proyecto de una LANDING DE CLIENTE
#
# Ninguna variable de Supabase va aquí. La landing solo conoce su llave de
# sitio y habla con la API de la plataforma: `SUPABASE_SECRET_KEY` se salta el
# RLS de todos los inquilinos, así que su filtración en el proyecto de un
# cliente sería la filtración de todos.
#
# Detalle en docs/PLATFORM.md.
# ---------------------------------------------------------------------------

# SITE_SLUG=tienda-del-cliente
# NITRO_API_URL=https://nitro-platform.vercel.app
# NITRO_SITE_KEY=nl_live_...
