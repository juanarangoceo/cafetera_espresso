# Landing de cliente de Nitro Landing.
#
# NO pongas aquí ninguna variable de Supabase. `SUPABASE_SECRET_KEY` se salta el
# RLS de todos los inquilinos: en el proyecto de un cliente, su filtración sería
# la de todos. Esta landing solo conoce su llave de sitio.

# La plataforma. Sin barra final.
NITRO_API_URL=https://PLATFORM_DOMAIN

# La llave de este sitio. Se emite desde /platform o con
# `npm run site:key -- emitir <slug>`, y se muestra una sola vez.
NITRO_SITE_KEY=nl_live_...

# Portal del comprador, que vive en la plataforma. Si se deja vacío, el icono de
# "consultar mi pedido" no se muestra.
NEXT_PUBLIC_NITRO_PORTAL_URL=https://PLATFORM_DOMAIN/login

# Asistentes. Opcionales: sin ellos la landing funciona, solo sin chat ni voz.
GEMINI_API_KEY=
OPENAI_API_KEY=
